[Unit]
Description=Vending Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user/vending
EnvironmentFile=-/home/user/vending/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/user/vending/venv/bin/python -u /home/user/vending/bot.py
Restart=always
RestartSec=3
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=20
StandardOutput=append:/home/user/vending/bot.out
StandardError=append:/home/user/vending/bot.out
SyslogIdentifier=vending-bot

[Install]
WantedBy=multi-user.target
